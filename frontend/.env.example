# Used only when running the frontend outside docker-compose against a
# different backend host/port. Not required for `docker compose up`.
VITE_API_PROXY_TARGET=http://localhost:8000

# Set this at build time when the frontend and backend are deployed as
# separate services on different origins (e.g. Render, where the frontend is
# a Static Site and the backend is its own Web Service). Leave unset for
# local dev and for any single-origin deployment — it defaults to "/api".
# Example: VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=
