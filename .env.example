# Copy this to backend/.env before running `docker compose up`.
# This top-level file is just a reference of the values used across services.
POSTGRES_DB=openpm
POSTGRES_USER=openpm
POSTGRES_PASSWORD=openpm

# Alternative to the three POSTGRES_* vars above — if set, this single
# connection string takes priority (this is what Render and most managed
# Postgres platforms provide). Leave unset for local docker-compose.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Sarah-OS integration account. Set this once to the password you were given;
# the backend will create/update the sarah-os superuser with it on every startup.
SARAH_OS_PASSWORD=
# Optional: bearer token the MCP integration server uses if run outside docker-compose.
# Leave unset to have the MCP server log in with the sarah-os username/password instead.
SARAH_OS_MCP_SHARED_SECRET=
